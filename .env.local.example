# .env.local.example — Template for testing Google OAuth on localhost
# Copy this file to .env.local and fill in real values.
# .env.local overrides .env and is gitignored.
#
# Usage:
#   1. Copy:  cp .env.local.example .env.local
#   2. Fill in your Google OAuth credentials
#   3. Restart: npm run dev
#   4. Test: http://localhost:3000/login
#
# To revert to development mode:
#   rm .env.local && npm run dev

# Disable development auth to use Google OAuth
AUTH_DEV_MODE="false"

# Google OAuth 2.0 credentials (get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Keep as localhost for local testing
NEXTAUTH_URL="http://localhost:3000"
