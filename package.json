{
  "name": "amanah-cash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run db:migrate && prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "env:check": "tsx scripts/check-environment.ts",
    "env:check:production": "tsx scripts/check-environment.ts --production",
    "auth:dev": "rm -f .env.local && echo 'Switched to development mode (AUTH_DEV_MODE=true). Restart: npm run dev'",
    "auth:google": "test -f .env.local && echo 'Google OAuth mode active (.env.local exists). Restart: npm run dev' || echo 'Create .env.local first: cp .env.local.example .env.local'",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:seed": "prisma generate && tsx scripts/seed-development.ts",
    "db:setup": "npm run env:check && npm run db:migrate && npm run db:seed",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "pretest": "prisma generate",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.js test/*.test.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-sqlite3": "12.11.1",
    "exceljs": "4.4.0",
    "geist": "1.7.2",
    "lucide-react": "1.27.0",
    "next": "16.2.11",
    "next-auth": "4.24.15",
    "pdfkit": "0.19.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "pdfjs-dist": "6.1.200",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "next-auth": {
      "uuid": "11.1.1"
    }
  }
}
